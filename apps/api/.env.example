PORT=3000

# SiliconFlow / DeepSeek text model, OpenAI-compatible API
OPENAI_API_KEY=sk-your-siliconflow-api-key
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL_NAME=deepseek-ai/DeepSeek-V3
AI_MOCK_MODE=false

# Image generation
IMAGE_PROVIDER=pollinations
IMAGE_MODEL=pollinations
IMAGE_SIZE=1024x1024
IMAGE_QUALITY=standard

# Database
MONGODB_URI=mongodb://localhost:27017/brand_flow
REDIS_HOST=localhost
REDIS_PORT=6379
