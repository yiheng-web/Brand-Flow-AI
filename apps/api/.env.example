PORT=3000

# SiliconFlow / DeepSeek text model, OpenAI-compatible API
# 在 https://cloud.siliconflow.cn/account/ak 创建密钥后粘贴到下方（勿使用占位符）
OPENAI_API_KEY=sk-your-siliconflow-api-key
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL_NAME=deepseek-ai/DeepSeek-V3
# 无有效密钥时设为 true，可本地跑通工作流（使用 Mock 数据，不调用真实模型）
AI_MOCK_MODE=false

# Image generation
IMAGE_PROVIDER=siliconflow
IMAGE_MODEL=Kwai-Kolors/Kolors
IMAGE_SIZE=1024x1024
IMAGE_BATCH_SIZE=1
IMAGE_NUM_INFERENCE_STEPS=20
IMAGE_GUIDANCE_SCALE=7.5
IMAGE_QUALITY=standard

# Database
MONGODB_URI=mongodb://localhost:27017/brand_flow
REDIS_HOST=localhost
REDIS_PORT=6379
