# 基础服务
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/brand_flow
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
JWT_SECRET=replace-with-a-long-random-secret

# 模型与向量服务（生产逻辑默认启用真实 Provider）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o
EMBEDDING_MODEL_NAME=BAAI/bge-m3
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
IMAGE_MODEL=Kwai-Kolors/Kolors
IMAGE_SIZE=1024x1024
IMAGE_BATCH_SIZE=1
IMAGE_NUM_INFERENCE_STEPS=20
IMAGE_GUIDANCE_SCALE=7.5
IMAGE_GENERATION_TIMEOUT_MS=120000

# 显式演示模式。默认 false；启用时 Agent 返回与真实接口相同的类型契约。
BRAND_FLOW_DEMO_MODE=false

# MinIO / S3 兼容对象存储
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=brandflow
MINIO_SECRET_KEY=replace-with-a-strong-secret
MINIO_ROOT_USER=brandflow
MINIO_ROOT_PASSWORD=replace-with-a-strong-secret
MINIO_BUCKET=brand-flow
MINIO_REGION=us-east-1
MINIO_SIGNED_URL_EXPIRES=900
MINIO_SERVER_URL=http://127.0.0.1:9000
MINIO_BROWSER_REDIRECT_URL=http://127.0.0.1:9002
