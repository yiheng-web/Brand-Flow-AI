### 变量
@baseUrl = http://localhost:3000/api
@accessToken = <登录后填写 JWT>
@workflowId = 6a22f6e97468d83197c53f05
@spaceId = personal
@knowledgeId = 6a22f6a57468d83197c53eec
@nodeType = creativeDirection

### 创建待启动工作流
POST {{baseUrl}}/workflow/create
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "prompt": "做一张夏日海报极简风格",
  "spaceId": "{{spaceId}}",
  "selectedKnowledgeBaseIds": ["{{knowledgeId}}"]
}

### 获取工作流详情
GET {{baseUrl}}/workflow/{{workflowId}}
Authorization: Bearer {{accessToken}}

### 更新指定节点输出
PUT {{baseUrl}}/workflow/{{workflowId}}/nodes/{{nodeType}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "selectedDirectionId": "<服务端返回的方向 ID>"
}

### 从指定节点重新运行工作流
POST {{baseUrl}}/workflow/{{workflowId}}/nodes/{{nodeType}}/run
Authorization: Bearer {{accessToken}}

### 订阅工作流 SSE 事件流
GET {{baseUrl}}/workflow/{{workflowId}}/stream
Authorization: Bearer {{accessToken}}


### 当前个人任务历史
GET {{baseUrl}}/workflows?spaceId=personal&page=1&limit=20
Authorization: Bearer {{accessToken}}

### 启动工作流
POST {{baseUrl}}/workflows/{{workflowId}}/start
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{ "needsComposition": false }

### 取消任务
POST {{baseUrl}}/workflows/{{workflowId}}/cancel
Authorization: Bearer {{accessToken}}

### 重试失败任务
POST {{baseUrl}}/workflows/{{workflowId}}/retry
Authorization: Bearer {{accessToken}}
