@nodeType = intentNode

### 创建个人空间工作流（不选择知识库）
POST {{baseUrl}}/workflow/create
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "prompt": "制作一张夏日海报，小猫主题，清爽极简风格",
  "spaceId": "{{personalSpaceId}}"
}

### 创建个人空间工作流（兼容旧字段 knowledgeId）
POST {{baseUrl}}/workflow/create
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "prompt": "做一张夏日海报极简风格",
  "spaceId": "{{personalSpaceId}}",
  "knowledgeId": "{{knowledgeId}}"
}

### 创建工作流（新版多知识库选择）
POST {{baseUrl}}/workflow/create
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "prompt": "做一张新品发布海报，使用品牌清爽调性，不要黑金奢华风",
  "spaceId": "{{teamSpaceId}}",
  "selectedKnowledgeBaseIds": [
    "{{knowledgeId}}",
    "{{knowledgeId2}}"
  ]
}

### 创建企业空间工作流
POST {{baseUrl}}/workflow/create
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "prompt": "基于企业品牌规范生成一张官方活动海报",
  "spaceId": "{{enterpriseSpaceId}}",
  "selectedKnowledgeBaseIds": [
    "{{knowledgeId}}"
  ]
}

### 获取工作流详情
GET {{baseUrl}}/workflow/{{workflowId}}
Authorization: Bearer {{accessToken}}

### 更新指定节点输出
PUT {{baseUrl}}/workflow/{{workflowId}}/nodes/{{nodeType}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "intent": "夏日海报",
  "confidence": 0.92,
  "reason": "用户明确提出夏日海报和极简风格",
  "suggestedAction": "继续进行知识库匹配和 Prompt 生成"
}

### 从指定节点重新运行工作流
POST {{baseUrl}}/workflow/{{workflowId}}/nodes/{{nodeType}}/run
Authorization: Bearer {{accessToken}}

### 订阅工作流 SSE 事件流
GET {{baseUrl}}/workflow/{{workflowId}}/stream
Authorization: Bearer {{accessToken}}

