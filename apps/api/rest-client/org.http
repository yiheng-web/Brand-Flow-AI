### 创建企业
POST {{baseUrl}}/org/enterprise
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "测试企业xxxx",
  "logo": "https://cdn.example.com/logo.png"
}

### 获取我的企业列表
GET {{baseUrl}}/org/enterprises
Authorization: Bearer {{accessToken}}

### 切换当前企业
PUT {{baseUrl}}/org/enterprise/{{enterpriseId}}/switch
Authorization: Bearer {{accessToken}}

### 创建团队
POST {{baseUrl}}/org/team
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "设计团队",
  "description": "负责品牌设计与物料生成"
}

### 获取当前企业团队列表
GET {{baseUrl}}/org/teams
Authorization: Bearer {{accessToken}}

### 获取当前用户可访问空间
GET {{baseUrl}}/org/spaces
Authorization: Bearer {{accessToken}}

### 获取个人空间上下文
GET {{baseUrl}}/org/spaces/personal/context
Authorization: Bearer {{accessToken}}

### 获取企业空间上下文
GET {{baseUrl}}/org/spaces/{{enterpriseId}}/context
Authorization: Bearer {{accessToken}}

### 获取团队空间上下文
GET {{baseUrl}}/org/spaces/{{teamSpaceId}}/context
Authorization: Bearer {{accessToken}}

### 获取空间成员列表
GET {{baseUrl}}/org/spaces/{{spaceId}}/members
Authorization: Bearer {{accessToken}}

### 邀请空间成员
POST {{baseUrl}}/org/spaces/{{spaceId}}/invitations
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "email": "member@example.com",
  "role": "member"
}

### 修改空间成员角色
PATCH {{baseUrl}}/org/spaces/{{spaceId}}/members/{{targetUserId}}/role
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "role": "admin"
}

### 移除空间成员
DELETE {{baseUrl}}/org/spaces/{{spaceId}}/members/{{targetUserId}}
Authorization: Bearer {{accessToken}}

### 获取企业品牌规则
GET {{baseUrl}}/org/enterprises/{{enterpriseId}}/brand-rules
Authorization: Bearer {{accessToken}}

### 更新企业品牌规则
PATCH {{baseUrl}}/org/enterprises/{{enterpriseId}}/brand-rules
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "requiredLogo": "https://cdn.example.com/brand-logo.png",
  "standardColors": ["#00A862", "#FFFFFF"],
  "bannedColors": ["#111111"],
  "bannedStyles": ["黑金奢华风", "低饱和灰色主视觉"],
  "brandVoice": "年轻、清爽、可信赖",
  "minExportScore": 7
}

### 获取企业权限策略
GET {{baseUrl}}/org/enterprises/{{enterpriseId}}/policies
Authorization: Bearer {{accessToken}}

### 更新企业权限策略
PATCH {{baseUrl}}/org/enterprises/{{enterpriseId}}/policies
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "requireEnterpriseKnowledgeBase": true,
  "allowPersonalKnowledgeInEnterpriseCreation": false,
  "teamKnowledgeRequiresReview": true,
  "worksDefaultToEnterprise": true,
  "memberCanExport": true,
  "allowExternalAssets": true,
  "allowExternalModels": false,
  "allowLowScoreExport": false
}

