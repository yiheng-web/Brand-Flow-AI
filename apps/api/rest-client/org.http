### 变量
@baseUrl = http://localhost:3000/api
@accessToken = paste-access_token-here
@enterpriseId = 6a22f3c98568f26d09d55767
@spaceId = personal

### 创建企业
POST {{baseUrl}}/org/enterprise
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "测试企业xxxx",
  "logo": "https://cdn.example.com/logo.png"
}

### 获取我的企业列表
GET {{baseUrl}}/org/enterprises
Authorization: Bearer {{accessToken}}

### 切换当前企业
PUT {{baseUrl}}/org/enterprise/{{enterpriseId}}/switch
Authorization: Bearer {{accessToken}}

### 创建团队
POST {{baseUrl}}/org/team
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "enterpriseId": "{{enterpriseId}}",
  "name": "设计团队",
  "description": "负责品牌设计与物料生成"
}

### 获取当前企业团队列表
GET {{baseUrl}}/org/teams
Authorization: Bearer {{accessToken}}

### 获取当前用户可访问空间
GET {{baseUrl}}/org/spaces
Authorization: Bearer {{accessToken}}

### 获取空间成员列表
GET {{baseUrl}}/org/spaces/{{spaceId}}/members
Authorization: Bearer {{accessToken}}

### 邀请空间成员
POST {{baseUrl}}/org/spaces/{{spaceId}}/invitations
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "email": "member@example.com",
  "role": "admin"
}


@teamId = replace-team-id
@targetUserId = replace-user-id
@invitationId = replace-invitation-id

### 编辑 / 停用 / 恢复企业（status 可改为 disabled）
PUT {{baseUrl}}/org/enterprise/{{enterpriseId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"name":"企业新名称","status":"active"}

### 编辑 / 归档 / 恢复团队
PUT {{baseUrl}}/org/team/{{teamId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"name":"团队新名称","description":"团队描述","status":"archived"}

### 删除团队：软归档，不删除资源
DELETE {{baseUrl}}/org/team/{{teamId}}
Authorization: Bearer {{accessToken}}

### 修改成员角色（OWNER 才能授予 admin，禁止 owner）
PUT {{baseUrl}}/org/spaces/{{spaceId}}/members/{{targetUserId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"role":"viewer"}

### 移除成员（企业移除同时移除团队关系）
DELETE {{baseUrl}}/org/spaces/{{spaceId}}/members/{{targetUserId}}
Authorization: Bearer {{accessToken}}

### 退出本人空间（OWNER 先转移）
POST {{baseUrl}}/org/spaces/{{spaceId}}/leave
Authorization: Bearer {{accessToken}}

### 企业 OWNER 转移至已有企业成员
PUT {{baseUrl}}/org/enterprise/{{enterpriseId}}/owner
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"targetUserId":"{{targetUserId}}"}

### 查看收到的邀请（改为 sent 可查看本人发出）
GET {{baseUrl}}/org/invitations?direction=received
Authorization: Bearer {{accessToken}}

### 接受本人邮箱的邀请（也可添加 inviteCode 字段）
POST {{baseUrl}}/org/invitations/{{invitationId}}/accept
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{}

### 拒绝本人邮箱邀请
POST {{baseUrl}}/org/invitations/{{invitationId}}/reject
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{}

### 撤销本人发出的邀请
POST {{baseUrl}}/org/invitations/{{invitationId}}/cancel
Authorization: Bearer {{accessToken}}

### 管理员读取当前空间审计；下一页添加 before=<上一页最后一条 _id>
GET {{baseUrl}}/org/spaces/{{spaceId}}/audits
Authorization: Bearer {{accessToken}}

### 本人通知
GET {{baseUrl}}/org/notifications
Authorization: Bearer {{accessToken}}

### 本人未读通知数
GET {{baseUrl}}/org/notifications/unread-count
Authorization: Bearer {{accessToken}}

### 标记本人通知已读
@notificationId = 替换为通知_id
PUT {{baseUrl}}/org/notifications/{{notificationId}}/read
Authorization: Bearer {{accessToken}}
