### 变量
@baseUrl = http://localhost:3000/api
@accessToken = <登录后填写JWT>
@knowledgeId = 6a22f6a57468d83197c53eec
@itemId = 6a22f6657468d83197c53ecd

### 创建知识库
POST {{baseUrl}}/knowledge
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "spaceId": "personal",
  "name": "瑞幸咖啡品牌规范库",
  "description": "包含品牌色、Logo 使用规范、禁用词和参考案例"
}

### 获取知识库列表
GET {{baseUrl}}/knowledge
Authorization: Bearer {{accessToken}}

### 获取知识库详情
GET {{baseUrl}}/knowledge/{{knowledgeId}}
Authorization: Bearer {{accessToken}}

### 更新知识库
PUT {{baseUrl}}/knowledge/{{knowledgeId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "瑞幸咖啡品牌规范库-更新",
  "description": "更新后的知识库描述"
}

### 将文本导入 Mongo 知识项（向量按配置同步）
POST {{baseUrl}}/knowledge/{{knowledgeId}}/ingest
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "content": "品牌主色为绿色，禁止使用低饱和灰色作为主视觉。Logo 必须保持清晰可见。"
}

### 创建知识项
POST {{baseUrl}}/knowledge/{{knowledgeId}}/items
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "title": "品牌色使用规范",
  "content": "品牌主色为 #00A862，重要活动海报必须保持 Logo 清晰可见。",
  "tags": ["品牌色", "Logo", "禁用项"],
  "metadata": {
    "source": "manual"
  }
}

### 获取知识项列表
GET {{baseUrl}}/knowledge/{{knowledgeId}}/items
Authorization: Bearer {{accessToken}}

### 获取知识项详情
GET {{baseUrl}}/knowledge/{{knowledgeId}}/items/{{itemId}}
Authorization: Bearer {{accessToken}}

### 更新知识项
PUT {{baseUrl}}/knowledge/{{knowledgeId}}/items/{{itemId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "title": "品牌色使用规范-更新",
  "content": "品牌主色为 #00A862，重要活动海报必须保持 Logo 清晰可见。",
  "tags": ["品牌色", "Logo"],
  "status": "active",
  "metadata": {
    "source": "manual"
  }
}

### 获取知识库底层向量记录
GET {{baseUrl}}/knowledge/{{knowledgeId}}/records
Authorization: Bearer {{accessToken}}

### 删除知识项
DELETE {{baseUrl}}/knowledge/{{knowledgeId}}/items/{{itemId}}
Authorization: Bearer {{accessToken}}

### 删除知识库
DELETE {{baseUrl}}/knowledge/{{knowledgeId}}
Authorization: Bearer {{accessToken}}


### 预览文本（复制响应 batchId 到下方，不落库）
POST {{baseUrl}}/knowledge/{{knowledgeId}}/import/preview
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{ "content": "[required] 主色必须为蓝色\n[optional] 可以使用渐变" }

### 确认导入（重试保持 batchId 和 items 相同）
POST {{baseUrl}}/knowledge/{{knowledgeId}}/import
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "batchId": "<预览响应中的UUID>",
  "items": [{ "title": "品牌色", "content": "主色必须为蓝色", "constraintLevel": "required" }]
}

### 归档知识项；改为 active 即启用
PUT {{baseUrl}}/knowledge/{{knowledgeId}}/items/{{itemId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{ "status": "archived" }

### 重试向量同步
POST {{baseUrl}}/knowledge/{{knowledgeId}}/items/{{itemId}}/vector-sync
Authorization: Bearer {{accessToken}}

### 组织范围（填写真实企业或团队 ID；需要对应 OWNER/ADMIN 权限）
@orgSpaceId = <企业或团队ID>
GET {{baseUrl}}/knowledge?spaceId={{orgSpaceId}}
Authorization: Bearer {{accessToken}}

### 新建团队必选库
POST {{baseUrl}}/knowledge
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "spaceId": "{{orgSpaceId}}", "name": "团队必选规则", "isRequired": true }

### 明确规则（企业规则不允许被下级覆盖，冲突返回409）
POST {{baseUrl}}/knowledge/{{knowledgeId}}/items
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "title": "品牌色", "content": "品牌色: #00A862", "constraintLevel": "required" }

### 人工确认自然语言；明确冲突仍然拒绝
POST {{baseUrl}}/knowledge/{{knowledgeId}}/items
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "title": "视觉风格", "content": "视觉年轻化", "metadata": { "inheritanceConfirmed": true } }
