### 变量
@baseUrl = http://localhost:3000/api
@accessToken = paste-login-or-switch-token-here
@spaceId = paste-space-id-from-get-org-spaces-here
@knowledgeId = paste-knowledge-id-here
@knowledgeItemId = paste-knowledge-item-id-here

### 创建知识库
# spaceId 必须来自 GET /org/spaces，不能使用 personal/team 这类字符串别名。
POST {{baseUrl}}/knowledge
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "spaceId": "{{spaceId}}",
  "name": "瑞幸咖啡品牌规范库 {{$timestamp}}",
  "description": "包含品牌色、Logo 使用规范、禁用词和参考案例"
}

### 获取当前工作区可访问知识库列表
GET {{baseUrl}}/knowledge
Authorization: Bearer {{accessToken}}

### 获取当前创作空间可选知识库
# 创作页知识库下拉框应该使用这个接口，而不是 GET /knowledge。
GET {{baseUrl}}/knowledge/selectable?spaceId={{spaceId}}
Authorization: Bearer {{accessToken}}

### 获取知识库详情
GET {{baseUrl}}/knowledge/{{knowledgeId}}
Authorization: Bearer {{accessToken}}

### 更新知识库
PUT {{baseUrl}}/knowledge/{{knowledgeId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "瑞幸咖啡品牌规范库-更新",
  "description": "更新后的知识库描述"
}

### 将文本写入知识库向量索引
POST {{baseUrl}}/knowledge/{{knowledgeId}}/ingest
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "content": "品牌主色为绿色，禁止使用低饱和灰色作为主视觉。Logo 必须保持清晰可见。"
}

### 创建知识项
POST {{baseUrl}}/knowledge/{{knowledgeId}}/items
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "title": "品牌色使用规范",
  "content": "品牌主色为 #00A862，重要活动海报必须保持 Logo 清晰可见。",
  "tags": ["品牌色", "Logo", "禁用项"],
  "metadata": {
    "source": "manual"
  }
}

### 获取知识项列表
GET {{baseUrl}}/knowledge/{{knowledgeId}}/items
Authorization: Bearer {{accessToken}}

### 获取知识项详情
GET {{baseUrl}}/knowledge/{{knowledgeId}}/items/{{knowledgeItemId}}
Authorization: Bearer {{accessToken}}

### 更新知识项
PUT {{baseUrl}}/knowledge/{{knowledgeId}}/items/{{knowledgeItemId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "title": "品牌色使用规范-更新",
  "content": "品牌主色为 #00A862，重要活动海报必须保持 Logo 清晰可见。",
  "tags": ["品牌色", "Logo"],
  "status": "active",
  "metadata": {
    "source": "manual"
  }
}

### 获取知识库底层向量记录
GET {{baseUrl}}/knowledge/{{knowledgeId}}/records
Authorization: Bearer {{accessToken}}

### 删除知识项
DELETE {{baseUrl}}/knowledge/{{knowledgeId}}/items/{{knowledgeItemId}}
Authorization: Bearer {{accessToken}}

### 删除知识库
DELETE {{baseUrl}}/knowledge/{{knowledgeId}}
Authorization: Bearer {{accessToken}}
