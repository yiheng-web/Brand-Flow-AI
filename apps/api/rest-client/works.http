### 变量
@baseUrl = http://localhost:3000/api
@accessToken = <登录后填写JWT>
@spaceId = personal
@workId = 6a22f9ef7468d83197c53f55
@versionId = 6a22f9ef7468d83197c53f57

### 获取作品列表
GET {{baseUrl}}/works?spaceId={{spaceId}}
Authorization: Bearer {{accessToken}}

### 获取作品详情
GET {{baseUrl}}/works/{{workId}}
Authorization: Bearer {{accessToken}}

### 创建作品
POST {{baseUrl}}/works
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "title": "测试作品",
  "description": "保存已完成且质检通过的可信工作流",
  "spaceId": "{{spaceId}}",
  "finalImageUrl": "https://example.invalid/ignored-client-preview.png",
  "workflowId": "6a22f9dc7468d83197c53f4c"
}

### 新增作品版本
POST {{baseUrl}}/works/{{workId}}/versions
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "workflowId": "6a22f9dc7468d83197c53f4c"
}

### 获取作品版本列表
GET {{baseUrl}}/works/{{workId}}/versions
Authorization: Bearer {{accessToken}}

### 获取作品版本详情
GET {{baseUrl}}/works/{{workId}}/versions/{{versionId}}
Authorization: Bearer {{accessToken}}

### 导出作品
POST {{baseUrl}}/works/{{workId}}/export
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "format": "png"
}

### 导出指定历史版本
POST {{baseUrl}}/works/{{workId}}/versions/{{versionId}}/export
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "format": "png"
}

### 删除作品
DELETE {{baseUrl}}/works/{{workId}}
Authorization: Bearer {{accessToken}}
