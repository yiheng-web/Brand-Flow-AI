@versionId = 6a22f9ef7468d83197c53f57

### 获取作品列表
GET {{baseUrl}}/works
Authorization: Bearer {{accessToken}}

### 获取作品详情
GET {{baseUrl}}/works/{{workId}}
Authorization: Bearer {{accessToken}}

### 创建作品
POST {{baseUrl}}/works
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "title": "测试作品",
  "description": "REST Client 创建的测试作品",
  "finalImageUrl": "https://cdn.example.com/works/final.png",
  "objectKey": "works/user/123/final.png",
  "workflowId": "6a22f9dc7468d83197c53f4c",
  "ownerId": "6a22f2148568f26d09d55759",
  "ownerType": "user",
  "visibility": "private",
  "qualityReport": {
    "totalScore": 86,
    "issues": []
  },
  "nodesSnapshot": {},
  "metadata": {
    "canvas": {
      "width": 1024,
      "height": 1024
    }
  }
}

### 新增作品版本
POST {{baseUrl}}/works/{{workId}}/versions
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "imageUrl": "https://cdn.example.com/works/final-v2.png",
  "objectKey": "works/user/123/final.png",
  "sourceWorkflowId": "6a22f9dc7468d83197c53f4c",
  "nodesSnapshot": {},
  "qualityReport": {
    "totalScore": 91,
    "issues": []
  }
}

### 获取作品版本列表
GET {{baseUrl}}/works/{{workId}}/versions
Authorization: Bearer {{accessToken}}

### 获取作品版本详情
GET {{baseUrl}}/works/{{workId}}/versions/{{versionId}}
Authorization: Bearer {{accessToken}}

### 导出作品
POST {{baseUrl}}/works/{{workId}}/export
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "format": "png"
}

### 删除作品
DELETE {{baseUrl}}/works/{{workId}}
Authorization: Bearer {{accessToken}}
